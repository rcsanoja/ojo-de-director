# Proveedor de IA: nvidia (gratis, por defecto) o claude (de pago, mejor crítica)
PROVIDER=nvidia

# NVIDIA (clave gratis en build.nvidia.com/settings/api-keys)
NVIDIA_API_KEY=nvapi-xxxxxxxx
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct
# Si NVIDIA da error de formato de imagen con tu modelo, cambia a: tag
NVIDIA_IMAGE_FORMAT=openai

# Claude (opcional; clave en console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Clave de acceso para que solo tú uses la app (muy recomendable)
APP_PASSWORD=pon-aqui-una-clave-larga
